# ── Servidor (Node + Socket.IO) ──────────────────────────────────────────────
# Porta HTTP/WebSocket. A Railway injeta PORT automaticamente; não defina lá.
PORT=3001

# Serviço deste deploy. Use `all` para compatibilidade local; no Dokploy,
# publique uma aplicação por valor: `lobby`, `whoami`, `impostor` ou `caracol`.
GAME_SERVICE=all

# Endereço de escuta.
HOST=0.0.0.0

# Origens permitidas pelo CORS do Socket.IO. Aceita lista separada por vírgula
# e `*` num rótulo de subdomínio, o que cobre os preview deploys da Vercel.
# Vazio reflete qualquer origem — serve para desenvolvimento, não para produção.
#   Um processo só servindo tudo:  http://localhost:3001
#   Vercel + Railway:              https://SEU-APP.vercel.app,https://*.vercel.app
PUBLIC_ORIGIN=http://localhost:3001

# Tempo de retenção de salas sem nenhuma conexão, em minutos.
ROOM_TTL_MINUTES=30

# ── Caracol (PostgreSQL + Push exclusivo) ────────────────────────────────────
# Em Docker, o compose monta o banco automaticamente e usa este segredo para
# o volume persistente. Em produção, troque por um segredo forte.
CARACOL_POSTGRES_PASSWORD=troque-por-um-segredo-forte

# Gere um par próprio do Caracol com `npx web-push generate-vapid-keys`.
# Nunca reutilize as chaves da Norwe e nunca publique a privada no frontend.
CARACOL_VAPID_PUBLIC_KEY=
CARACOL_VAPID_PRIVATE_KEY=
CARACOL_VAPID_SUBJECT=mailto:caracol@gamegamegame.site

# ── Interface (Vite) ─────────────────────────────────────────────────────────
# URL do servidor Socket.IO. Lida em tempo de BUILD, então mudá-la exige novo
# deploy da interface. Deixe vazia quando um único processo serve tudo (o
# cliente conecta na própria origem) ou em desenvolvimento (o Vite faz proxy
# para localhost:3001).
#   Vercel + Railway: VITE_SERVER_URL=https://SEU-APP.up.railway.app
VITE_SERVER_URL=

# URLs do lobby para os serviços independentes. Podem ser subdomínios ou rotas
# no mesmo domínio, conforme o proxy do Dokploy.
VITE_GAME_SERVICE=all
VITE_LOBBY_URL=https://gamegamegame.site
VITE_WHOAMI_URL=https://whoami.gamegamegame.site
VITE_IMPOSTOR_URL=https://impostor.gamegamegame.site
VITE_CARACOL_URL=https://caracol.gamegamegame.site

# ── Docker Compose ───────────────────────────────────────────────────────────
# Porta publicada pelo Nginx na sua máquina.
WHOAMI_PORT=8080
